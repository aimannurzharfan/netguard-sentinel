# NetGuard Sentinel -- environment template.
# Copy to .env and fill in real values. Never commit .env.

# --- Microsoft Foundry (wire on Day 4, ~June 9) ---
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=

# --- Oracle 23ai local Docker ---
# ORACLE_USER and ORACLE_DSN have sensible defaults; only ORACLE_PASSWORD is required.
# Set ORACLE_PASSWORD to the value you passed as ORACLE_PASSWORD when starting the container.
# ORACLE_USER=system
# ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_PASSWORD=

# --- Threat data ---
# NVD API key: optional, raises the rate limit.
# Request at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
