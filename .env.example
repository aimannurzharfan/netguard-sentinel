# NetGuard Sentinel -- environment template.
# Copy to .env and fill in real values. Never commit .env.

# --- Microsoft Foundry (Phi-4-reasoning) ---
# FOUNDRY_ENDPOINT: the OpenAI-compatible base URL for your Foundry deployment.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1
# Alternatively, set FOUNDRY_PROJECT_ENDPOINT and /openai/v1 is appended automatically.
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=Phi-4-reasoning
FOUNDRY_API_KEY=

# --- Oracle 23ai local Docker ---
# ORACLE_USER and ORACLE_DSN have sensible defaults; only ORACLE_PASSWORD is required.
# Set ORACLE_PASSWORD to the value you passed as ORACLE_PASSWORD when starting the container.
# ORACLE_USER=system
# ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_PASSWORD=

# --- Threat data ---
# NVD API key: optional, raises the rate limit.
# Request at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- 21st.dev Magic MCP (UI component generation) ---
# Get a key at https://21st.dev/magic/console
TWENTY_FIRST_API_KEY=
