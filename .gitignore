# Secrets
.env
*.pem
*.key

# Dev-only / local tooling
_local/
CLAUDE.md
.claude/
.mcp.json

# Node tooling. node_modules is ignored everywhere; only the repo-root
# package.json/lock (MCP dev tooling) are ignored. The frontend/ app keeps its
# own package.json and lockfile so the SPA can be reinstalled and rebuilt.
node_modules/
/package-lock.json
/package.json

# Python (anchored to repo root so the built SPA in web/dist is not ignored)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.venv*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated threat-data cache (rebuilt by data/fetch_cache.py)
data/cache/
!data/cache/cves.json

# Oracle wallet (never commit)
wallet/
Wallet_*.zip
tnsnames.ora
sqlnet.ora

# OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
