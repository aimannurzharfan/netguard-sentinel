flowchart TD
    subgraph LOCAL["Local machine"]
        UI["React Web UI\n(web/dist)"]
        CLI["CLI\npython -m netguard_sentinel &lt;host&gt;"]
        SERVER["Flask server (web/server.py)\ntarget-policy guard - rate limit"]
        SCANNER["scanner/scan.py\nTCP connect - banner grab - fingerprint"]
        AGENT["agent/agent.py\n6-step pipeline: intake, enrich, score,\nrank, attack-path, remediate"]
        TOOL["threat_intel_lookup\n(tools/threat_intel.py)"]
        CACHE["Layer 1: local cache\ndata/cache/cves.json\nNVD - EPSS - CISA KEV"]
        ORACLE["Layer 2: Oracle 23ai in Docker\nAI Vector Search"]
        FALLBACK["Deterministic local fallback\nused when Foundry is unavailable"]
        RESULT["TriageResult JSON\nfindings ranked worst-first\nby composite CVSS + EPSS + KEV\nMITRE ATT&CK - remediation"]
    end

    subgraph AZURE["Microsoft Azure AI Foundry"]
        FOUNDRY["Microsoft Foundry - Phi-4-mini-instruct"]
    end

    UI -->|"POST /scan"| SERVER
    CLI --> SCANNER
    SERVER --> SCANNER
    SCANNER -->|"scan JSON"| AGENT
    AGENT --> TOOL
    TOOL -->|"THREAT_BACKEND=cache"| CACHE
    TOOL -->|"THREAT_BACKEND=oracle"| ORACLE
    AGENT <-->|"attack-path narrative\nand remediation prose"| FOUNDRY
    AGENT -.-> FALLBACK
    AGENT --> RESULT
    RESULT -->|"rendered"| UI
